NICHEFORGE_ENV=development
NICHEFORGE_DATABASE_URL=sqlite:///./nicheforge.db
NICHEFORGE_SV_PROVIDER=mock
NICHEFORGE_SERP_PROVIDER=mock
NICHEFORGE_AUTHORITY_PROVIDER=mock

# DataForSEO (optional live SV/SERP provider)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_MODE=SANDBOX
DATAFORSEO_PROVIDER_ENABLED=true
DATAFORSEO_TRIAL_APPROVED=false
DATAFORSEO_TRIAL_BUDGET=0
DATAFORSEO_SERP_ESTIMATED_COST=0

# Moz adapter is deliberately configurable because account/API contracts can vary.
# Set these only after confirming the authorized Moz API contract for your account.
MOZ_API_BASE_URL=
MOZ_API_TOKEN=
MOZ_API_AUTH_MODE=bearer
MOZ_URL_METRICS_PATH=

# U.S. Census Population Estimates API
CENSUS_API_KEY=
CENSUS_API_ENABLED=false
CENSUS_API_BASE_URL=https://api.census.gov
